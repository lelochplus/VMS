// Sipeed Tang Nano 20K, chân lấy theo apicula/examples/tangnano20k.cst
IO_LOC  "clk" 4;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
CLOCK_LOC "clk" BUFG;

IO_LOC  "btn_s1" 88;
IO_PORT "btn_s1" IO_TYPE=LVCMOS33;

IO_LOC  "uart_tx" 69;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

IO_LOC  "led0" 15;
IO_PORT "led0" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

// LED gỡ lỗi
IO_LOC  "dbg_led[0]" 16;
IO_PORT "dbg_led[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "dbg_led[1]" 17;
IO_PORT "dbg_led[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "dbg_led[2]" 18;
IO_PORT "dbg_led[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
